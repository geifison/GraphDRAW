{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphdraw.invalid/format/gdr-1.0.schema.json",
  "title": "GraphDraw — document.json (formato .gdr 1.x)",
  "description": "Esquema de document.json do formato nativo .gdr (docs/spec/13-FORMATO-GDR.md). Coordenadas e comprimentos em micrômetros (µm), eixo Y para cima, origem no canto inferior esquerdo da página. Campos desconhecidos são permitidos e devem ser preservados por leitores (GD-GDR-03).",
  "type": "object",
  "required": ["formatVersion", "pages"],
  "properties": {
    "formatVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "Versão semântica do formato; leitores aceitam a mesma versão maior."
    },
    "settings": { "$ref": "#/$defs/settings" },
    "masterPage": {
      "type": "object",
      "properties": {
        "layers": { "type": "array", "items": { "$ref": "#/$defs/layer" } }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/page" },
          { "$ref": "#/$defs/pageRef" }
        ]
      }
    }
  },
  "$defs": {
    "um": {
      "type": "number",
      "description": "Comprimento ou coordenada em micrômetros."
    },
    "point": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Identificador estável; o GraphDraw gera UUID v7."
    },
    "transform": {
      "type": "array",
      "description": "Matriz afim [a,b,c,d,e,f]: x' = a·x + c·y + e; y' = b·x + d·y + f.",
      "items": { "type": "number" },
      "minItems": 6,
      "maxItems": 6
    },
    "settings": {
      "type": "object",
      "properties": {
        "displayUnit": { "enum": ["mm", "cm", "in", "pt", "pc", "px", "um"] },
        "origin": { "enum": ["bottom-left", "top-left", "bottom-right", "top-right", "center"] },
        "bleed": { "$ref": "#/$defs/um", "minimum": 0 },
        "drawingScale": {
          "type": "array",
          "items": { "type": "number", "exclusiveMinimum": 0 },
          "minItems": 2,
          "maxItems": 2
        },
        "resolution": { "type": "number", "exclusiveMinimum": 0 },
        "color": {
          "type": "object",
          "properties": {
            "rgbProfile": { "type": "string" },
            "cmykProfile": { "type": "string" },
            "intent": { "enum": ["perceptual", "relative", "saturation", "absolute"] },
            "blackPoint": { "type": "boolean" }
          }
        },
        "guides": { "type": "array", "items": { "$ref": "#/$defs/guide" } },
        "fillOpenPaths": { "type": "boolean", "description": "Caminhos abertos recebem preenchimento (GD-FIL-12)." },
        "embedFonts": { "type": "boolean" },
        "preflight": {
          "type": "object",
          "description": "Limites da verificação prévia (GD-PRE-02).",
          "properties": {
            "tac": { "type": "number", "minimum": 0 },
            "minLine": { "$ref": "#/$defs/um", "minimum": 0 },
            "minLineNegative": { "$ref": "#/$defs/um", "minimum": 0 },
            "safeZone": { "$ref": "#/$defs/um", "minimum": 0 },
            "nearEdge": { "$ref": "#/$defs/um", "minimum": 0 },
            "blackTextSize": { "$ref": "#/$defs/um", "minimum": 0 }
          }
        }
      }
    },
    "color": {
      "type": "object",
      "required": ["model", "values"],
      "properties": {
        "model": { "enum": ["rgb", "cmyk", "gray", "lab", "hsb", "hls", "spot", "registration"] },
        "values": { "type": "array", "items": { "type": "number" } },
        "name": { "type": "string" },
        "ref": { "type": "string", "description": "ID de cor global em resources/colors.json." },
        "alternate": { "$ref": "#/$defs/color" }
      },
      "allOf": [
        {
          "if": { "properties": { "model": { "const": "rgb" } } },
          "then": { "properties": { "values": { "minItems": 3, "maxItems": 3, "items": { "minimum": 0, "maximum": 1 } } } }
        },
        {
          "if": { "properties": { "model": { "const": "cmyk" } } },
          "then": { "properties": { "values": { "minItems": 4, "maxItems": 4, "items": { "minimum": 0, "maximum": 1 } } } }
        },
        {
          "if": { "properties": { "model": { "enum": ["gray", "spot", "registration"] } } },
          "then": { "properties": { "values": { "minItems": 1, "maxItems": 1, "items": { "minimum": 0, "maximum": 1 } } } }
        },
        {
          "if": { "properties": { "model": { "const": "lab" } } },
          "then": { "properties": { "values": { "minItems": 3, "maxItems": 3 } } }
        },
        {
          "if": { "properties": { "model": { "const": "spot" } } },
          "then": { "required": ["name"] }
        }
      ]
    },
    "gradientStop": {
      "type": "object",
      "required": ["offset", "color"],
      "properties": {
        "offset": { "type": "number", "minimum": 0, "maximum": 1 },
        "color": { "$ref": "#/$defs/color" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "midpoint": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "fill": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "solid" } } },
          "then": {
            "required": ["color"],
            "properties": {
              "color": { "$ref": "#/$defs/color" },
              "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
              "overprint": { "type": "boolean" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "pattern" } } },
          "then": {
            "required": ["kind", "width", "height"],
            "properties": {
              "kind": { "enum": ["vector", "bitmap", "two-color", "texture"] },
              "texture": {
                "type": "object",
                "properties": {
                  "style": { "enum": ["clouds", "marble", "wood", "granite"] },
                  "seed": { "type": "integer", "minimum": 0 },
                  "frequency": { "type": "number", "minimum": 1 },
                  "detail": { "type": "integer", "minimum": 1, "maximum": 8 },
                  "contrast": { "type": "number", "minimum": 0, "maximum": 1 }
                }
              },
              "tile": { "type": "array", "items": { "$ref": "#/$defs/object" } },
              "src": { "type": "string", "pattern": "^resources/images/[0-9a-f]{64}\\.(png|jpg|jpeg|tif|tiff|webp)$" },
              "cells": { "type": "array", "items": { "type": "string", "pattern": "^[01]*$" } },
              "fg": { "$ref": "#/$defs/color" },
              "bg": { "$ref": "#/$defs/color" },
              "width": { "type": "number", "exclusiveMinimum": 0 },
              "height": { "type": "number", "exclusiveMinimum": 0 },
              "origin": { "$ref": "#/$defs/point" },
              "scale": { "type": "number", "exclusiveMinimum": 0 },
              "rotation": { "type": "number" },
              "rowOffset": { "type": "number" },
              "columnOffset": { "type": "number" },
              "mirror": { "type": "boolean" },
              "transformWithObject": { "type": "boolean" },
              "resolution": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "gradient" } } },
          "then": {
            "required": ["kind", "stops"],
            "properties": {
              "kind": { "enum": ["linear", "radial", "elliptic", "conic", "rectangular"] },
              "stops": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/gradientStop" } },
              "start": { "$ref": "#/$defs/point" },
              "end": { "$ref": "#/$defs/point" },
              "center": { "$ref": "#/$defs/point" },
              "radius": { "type": "number", "exclusiveMinimum": 0 },
              "radiusY": { "type": "number", "exclusiveMinimum": 0 },
              "angle": { "type": "number" },
              "spread": { "enum": ["pad", "repeat", "reflect"] },
              "steps": { "type": "integer", "minimum": 1 },
              "smooth": { "type": "boolean" },
              "colorPath": { "enum": ["direct", "cw", "ccw"] }
            },
            "allOf": [
              {
                "if": { "properties": { "kind": { "const": "linear" } } },
                "then": { "required": ["start", "end"] }
              },
              {
                "if": { "properties": { "kind": { "enum": ["radial", "elliptic", "conic", "rectangular"] } } },
                "then": { "required": ["center", "radius"] }
              }
            ]
          }
        }
      ]
    },
    "stroke": {
      "type": "object",
      "required": ["width", "color"],
      "properties": {
        "width": { "type": "number", "minimum": 0, "description": "µm; 0 = fio de cabelo." },
        "color": { "$ref": "#/$defs/color" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "dash": { "type": "array", "items": { "type": "number", "minimum": 0 } },
        "dashOffset": { "type": "number" },
        "join": { "enum": ["miter", "round", "bevel"] },
        "miterLimit": { "type": "number", "minimum": 1 },
        "cap": { "enum": ["butt", "round", "square"] },
        "position": { "enum": ["center", "inside", "outside"] },
        "scaleWithObject": { "type": "boolean" },
        "behindFill": { "type": "boolean" },
        "startArrow": { "$ref": "#/$defs/arrow" },
        "endArrow": { "$ref": "#/$defs/arrow" },
        "nibStretch": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "Caneta caligráfica: largura do bico (1 = redondo)." },
        "nibAngle": { "type": "number", "description": "Ângulo do bico em graus." },
        "overprint": { "type": "boolean", "description": "Sobreimpressão do contorno (GD-PRE-08)." },
        "dashCorners": { "enum": ["standard", "align", "fixed"], "description": "Tracejado nos cantos (GD-OUT-03)." },
        "widths": {
          "type": "array",
          "description": "Largura variável (GD-VAR-01): nós ao longo do caminho.",
          "items": {
            "type": "object",
            "required": ["at", "left", "right"],
            "properties": {
              "at": { "type": "number", "minimum": 0, "maximum": 1 },
              "left": { "type": "number", "minimum": 0 },
              "right": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "arrow": {
      "type": "object",
      "required": ["shape"],
      "properties": {
        "shape": { "type": "string", "description": "triangle, open, barbed, circle, square ou bar; outros valores são preservados e desenhados como triangle." },
        "scale": { "type": "number", "exclusiveMinimum": 0 },
        "offset": { "type": "number", "description": "µm" },
        "rotation": { "type": "number", "description": "graus" },
        "mirror": { "type": "boolean" }
      }
    },
    "node": {
      "type": "object",
      "required": ["p"],
      "properties": {
        "p": { "$ref": "#/$defs/point" },
        "in": { "$ref": "#/$defs/point" },
        "out": { "$ref": "#/$defs/point" },
        "kind": { "enum": ["corner", "smooth", "symmetric"] }
      }
    },
    "subpath": {
      "type": "object",
      "required": ["closed", "nodes"],
      "properties": {
        "closed": { "type": "boolean" },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } }
      }
    },
    "corner": {
      "type": "object",
      "required": ["kind", "radius"],
      "properties": {
        "kind": { "enum": ["round", "chamfer", "scallop"] },
        "radius": { "type": "number", "minimum": 0 }
      }
    },
    "fontSpec": {
      "type": "object",
      "required": ["family", "size"],
      "properties": {
        "family": { "type": "string" },
        "size": { "type": "number", "exclusiveMinimum": 0, "description": "Corpo em µm." },
        "weight": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "italic": { "type": "boolean" }
      }
    },
    "textSpan": {
      "type": "object",
      "required": ["text", "font"],
      "properties": {
        "text": { "type": "string" },
        "font": { "$ref": "#/$defs/fontSpec" },
        "fill": { "$ref": "#/$defs/fill" }
      }
    },
    "paragraph": {
      "type": "object",
      "required": ["spans"],
      "properties": {
        "align": { "enum": ["left", "center", "right", "justify", "forceJustify"] },
        "hyphenate": { "type": "boolean" },
        "lang": { "type": "string" },
        "spans": { "type": "array", "items": { "$ref": "#/$defs/textSpan" } }
      }
    },
    "object": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string", "description": "Tipos desconhecidos são preservados sem exibição." },
        "name": { "type": "string" },
        "transform": { "$ref": "#/$defs/transform" },
        "fill": { "$ref": "#/$defs/fill" },
        "stroke": { "$ref": "#/$defs/stroke" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "printable": { "type": "boolean" },
        "userData": { "type": "object", "additionalProperties": { "type": "string" } },
        "blendMode": { "enum": ["normal", "multiply", "screen", "overlay", "darken", "lighten", "color-dodge", "color-burn", "hard-light", "soft-light", "difference", "exclusion", "hue", "saturation", "color", "luminosity"] },
        "objectStyle": { "type": "string", "description": "ID do estilo de objeto em resources/styles.json." },
        "textStyle": { "type": "string", "description": "ID do estilo de texto em resources/styles.json." },
        "textWrap": {
          "type": "object",
          "description": "Afasta o texto de parágrafo da página (GD-TXT-10).",
          "required": ["style", "side"],
          "properties": {
            "style": { "enum": ["contour", "square"] },
            "side": { "enum": ["both", "left", "right", "above-below"] },
            "distance": { "type": "number", "minimum": 0 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "path" } } },
          "then": {
            "required": ["subpaths"],
            "properties": {
              "subpaths": { "type": "array", "items": { "$ref": "#/$defs/subpath" } },
              "fillRule": { "enum": ["evenodd", "nonzero"] }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "rectangle" } } },
          "then": {
            "required": ["width", "height"],
            "properties": {
              "width": { "$ref": "#/$defs/um" },
              "height": { "$ref": "#/$defs/um" },
              "corners": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/corner" } }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "ellipse" } } },
          "then": {
            "required": ["rx", "ry"],
            "properties": {
              "rx": { "$ref": "#/$defs/um" },
              "ry": { "$ref": "#/$defs/um" },
              "mode": { "enum": ["ellipse", "arc", "pie"] },
              "startAngle": { "type": "number" },
              "endAngle": { "type": "number" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "polygon" } } },
          "then": {
            "required": ["rx", "ry", "sides"],
            "properties": {
              "rx": { "$ref": "#/$defs/um" },
              "ry": { "$ref": "#/$defs/um" },
              "sides": { "type": "integer", "minimum": 3, "maximum": 500 },
              "mode": { "enum": ["polygon", "star", "complex"] },
              "sharpness": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "group" } } },
          "then": {
            "required": ["children"],
            "properties": {
              "children": { "type": "array", "items": { "$ref": "#/$defs/object" } },
              "boolean": { "enum": ["weld", "trim", "intersect"] },
              "symbol": { "type": "string", "description": "Instância do símbolo com este ID (resources/styles.json)." },
              "effect": {
                "type": "object",
                "required": ["kind"],
                "properties": {
                  "kind": { "enum": ["contour", "blend", "drop-shadow", "block", "envelope"] },
                  "direction": { "enum": ["outside", "inside", "center"] },
                  "corners": { "enum": ["round", "miter", "bevel"] },
                  "accel": { "type": "number", "minimum": -100, "maximum": 100 },
                  "colorAccel": { "type": "number", "minimum": -100, "maximum": 100 },
                  "rotation": { "type": "number" },
                  "scale": { "type": "number", "exclusiveMinimum": 0 },
                  "taper": { "type": "number", "minimum": 0 },
                  "steps": { "type": "integer", "minimum": 1 },
                  "distance": { "type": "number" },
                  "endColor": { "$ref": "#/$defs/color" },
                  "offset": { "$ref": "#/$defs/point" },
                  "blur": { "type": "number", "minimum": 0 },
                  "color": { "$ref": "#/$defs/color" },
                  "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
                  "angle": { "type": "number" },
                  "depth": { "type": "number" },
                  "frame": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
                  "points": { "type": "array", "items": { "$ref": "#/$defs/point" }, "minItems": 8, "maxItems": 8 }
                }
              },
              "symmetry": {
                "type": "object",
                "required": ["kind", "count", "center"],
                "properties": {
                  "kind": { "enum": ["mirror", "radial"] },
                  "count": { "type": "integer", "minimum": 1, "maximum": 64 },
                  "center": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
                  "angle": { "type": "number" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "text" } } },
          "then": {
            "required": ["paragraphs"],
            "properties": {
              "textKind": { "enum": ["artistic", "paragraph"] },
              "frame": { "$ref": "#/$defs/point" },
              "paragraphs": { "type": "array", "items": { "$ref": "#/$defs/paragraph" } },
              "lineSpacing": { "type": "number", "exclusiveMinimum": 0 },
              "path": {
                "type": "object",
                "required": ["subpaths"],
                "properties": {
                  "subpaths": { "type": "array", "items": { "$ref": "#/$defs/subpath" } },
                  "offset": { "type": "number" },
                  "distance": { "type": "number" },
                  "side": { "enum": ["above", "below"] },
                  "orientation": { "enum": ["rotate", "skew-v", "skew-h", "upright"] },
                  "mirror": { "type": "boolean" },
                  "guide": { "type": "string", "description": "ID do objeto de onde veio a forma do caminho." },
                  "detached": { "type": "boolean", "description": "Já separado do caminho guia (GD-CMB-03): mantém a curva, independente." }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "image" } } },
          "then": {
            "required": ["width", "height", "src"],
            "properties": {
              "width": { "$ref": "#/$defs/um" },
              "height": { "$ref": "#/$defs/um" },
              "src": { "type": "string", "pattern": "^resources/images/[0-9a-f]{64}\\.(png|jpg|jpeg|tif|tiff|webp)$" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "basic" } } },
          "then": {
            "required": ["shape", "width", "height"],
            "properties": {
              "shape": { "enum": ["arrow", "double-arrow", "chevron", "flow-process", "flow-decision", "flow-terminator", "flow-data", "flow-document", "banner", "speech", "thought", "plus", "heart"] },
              "width": { "$ref": "#/$defs/um" },
              "height": { "$ref": "#/$defs/um" },
              "params": { "type": "array", "items": { "type": "number" } }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "bspline" } } },
          "then": {
            "required": ["points"],
            "properties": {
              "points": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["p"],
                  "properties": {
                    "p": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
                    "fixed": { "type": "boolean" }
                  }
                }
              },
              "closed": { "type": "boolean" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "connector" } } },
          "then": {
            "required": ["style", "from", "to"],
            "properties": {
              "style": { "enum": ["straight", "elbow", "curved"] },
              "radius": { "type": "number", "minimum": 0 },
              "from": { "$ref": "#/$defs/connEnd" },
              "to": { "$ref": "#/$defs/connEnd" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "dimension" } } },
          "then": {
            "required": ["dimKind", "points"],
            "properties": {
              "dimKind": { "enum": ["horizontal", "vertical", "aligned", "angular", "radius", "diameter", "segment"] },
              "points": { "type": "array", "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }, "minItems": 2, "maxItems": 3 },
              "offset": { "type": "number" },
              "links": { "type": "array", "items": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/dimLink" }] } },
              "segment": { "$ref": "#/$defs/dimLink" },
              "format": {
                "type": "object",
                "properties": {
                  "unit": { "enum": ["mm", "cm", "m", "in", "pt"] },
                  "precision": { "type": "integer", "minimum": 0, "maximum": 6 },
                  "prefix": { "type": "string" },
                  "suffix": { "type": "string" },
                  "showUnit": { "type": "boolean" },
                  "textPosition": { "enum": ["above", "inline"] },
                  "arrow": { "enum": ["triangle", "open", "barbed", "circle", "square", "bar", "none"] },
                  "extensionLines": { "type": "boolean" },
                  "textSize": { "$ref": "#/$defs/um" },
                  "font": { "type": "string" }
                }
              }
            }
          }
        }
      ]
    },
    "connEnd": {
      "type": "object",
      "required": ["point"],
      "properties": {
        "point": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "object": { "type": "string" },
        "anchor": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 }, "minItems": 2, "maxItems": 2 }
      }
    },
    "dimLink": {
      "type": "object",
      "description": "Nó (ou segmento) medido por uma cota (GD-COT-02).",
      "required": ["object", "subpath", "node"],
      "properties": {
        "object": { "type": "string" },
        "subpath": { "type": "integer", "minimum": 0 },
        "node": { "type": "integer", "minimum": 0 }
      }
    },
    "layer": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "visible": { "type": "boolean" },
        "printable": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "color": { "$ref": "#/$defs/color" },
        "wireframe": { "type": "boolean" },
        "guides": { "type": "boolean", "description": "Camada de guias (GD-GUI-03)." },
        "objects": { "type": "array", "items": { "$ref": "#/$defs/object" } }
      }
    },
    "guide": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["horizontal", "vertical", "angled"] },
        "position": { "$ref": "#/$defs/um" },
        "point": { "$ref": "#/$defs/point" },
        "angle": { "type": "number" },
        "locked": { "type": "boolean" },
        "color": { "$ref": "#/$defs/color" }
      }
    },
    "page": {
      "type": "object",
      "required": ["id", "width", "height"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "background": { "$ref": "#/$defs/color" },
        "hideMaster": { "type": "boolean" },
        "bleed": { "type": "number", "minimum": 0, "description": "Sangria própria em µm; ausente = settings.bleed." },
        "locked": { "type": "boolean", "description": "Página bloqueada para edição." },
        "tagColor": { "$ref": "#/$defs/color", "description": "Etiqueta de cor da aba (organização)." },
        "guides": { "type": "array", "items": { "$ref": "#/$defs/guide" } },
        "layers": { "type": "array", "items": { "$ref": "#/$defs/layer" } }
      }
    },
    "pageRef": {
      "type": "object",
      "required": ["src"],
      "properties": {
        "src": { "type": "string", "pattern": "^pages/page-[0-9]+\\.json$" }
      },
      "description": "Página gravada num membro separado (GD-GDR-11); o membro segue #/$defs/page."
    }
  }
}
